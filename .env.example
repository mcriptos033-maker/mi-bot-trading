# Token de tu bot de Telegram (obtenlo hablando con @BotFather en Telegram)
TELEGRAM_TOKEN=your_bot_token_here

# API Key de Anthropic para el análisis IA (obtenla en console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Zona horaria — ejemplos: America/Argentina/Buenos_Aires | Europe/Madrid | America/New_York
TIMEZONE=America/Argentina/Buenos_Aires

# Hora del resumen diario (formato 24h)
MORNING_HOUR=7
MORNING_MINUTE=0

# Minutos de anticipación para la alerta previa a cada noticia
PRE_NEWS_MINUTES=7

# Minutos después del evento para buscar el dato real y hacer análisis
POST_EVENT_DELAY_MIN=12
